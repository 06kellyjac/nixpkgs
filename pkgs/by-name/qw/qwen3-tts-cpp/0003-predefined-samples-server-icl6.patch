+
+namespace qwen3_tts {
+
+struct GGUFVoiceBankEntryBuilder {
+    std::string name;
+
+    std::vector<float> embedding;
+
+    std::vector<uint16_t> ref_codes;
+
+    uint32_t n_ref_frames = 0;
+    uint32_t n_ref_codebooks = 0;
+
+    std::string ref_text;
+    std::string ref_audio_sha256;
+};
+
+class GGUFVoiceBankWriter {
+public:
+    GGUFVoiceBankWriter();
+
+    void addVoice(const GGUFVoiceBankEntryBuilder& voice);
+
+    void setSchemaVersion(uint32_t v) { schema_version_ = v; }
+
+    bool writeToFile(const std::string& path);
+
+private:
+    std::vector<GGUFVoiceBankEntryBuilder> voices_;
+    uint32_t schema_version_ = 1;
+
+private:
+    void validate() const;
+};
+
+} // namespace qwen3_tts
