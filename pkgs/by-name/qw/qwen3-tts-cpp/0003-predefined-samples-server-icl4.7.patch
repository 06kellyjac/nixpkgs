+// Save a vector of floats as GGUF file with support for ICL data
+static bool save_embedding_as_gguf(const std::string& filename, const std::vector<float>& embedding,
+                                   const std::string& ref_text = "", 
+                                   const std::vector<int32_t>& ref_codes = {},
+                                   int32_t n_ref_frames = 0) {
+    // Create a simple GGUF header for storing embeddings and ICL data
+    FILE* file = fopen(filename.c_str(), "wb");
+    if (!file) return false;
+    
+    // Simple GGUF-like structure:
+    // Magic number (4 bytes)
+    uint32_t magic = 0x47475546;  // "GGUF"
+    fwrite(&magic, sizeof(magic), 1, file);
+    
+    // Version (4 bytes) - now supports ICL data
+    uint32_t version = 2;
+    fwrite(&version, sizeof(version), 1, file);
+    
+    // Data type flag (1 byte)
+    // 0 = simple embedding only
+    // 1 = embedding + ref_text + ref_codes + n_ref_frames
+    uint8_t data_type = (ref_text.empty() && ref_codes.empty()) ? 0 : 1;
+    fwrite(&data_type, sizeof(data_type), 1, file);
+    
+    if (data_type == 1) {
+        // Store ref_text length and data
+        uint32_t ref_text_len = ref_text.length();
+        fwrite(&ref_text_len, sizeof(ref_text_len), 1, file);
+        fwrite(ref_text.c_str(), 1, ref_text_len, file);
+        
+        // Store ref_codes count and data
+        uint32_t ref_codes_count = ref_codes.size();
+        fwrite(&ref_codes_count, sizeof(ref_codes_count), 1, file);
+        if (!ref_codes.empty()) {
+            fwrite(ref_codes.data(), sizeof(int32_t), ref_codes_count, file);
+        }
+        
+        // Store n_ref_frames
+        fwrite(&n_ref_frames, sizeof(n_ref_frames), 1, file);
+    }
+    
+    // Store embedding data
+    uint32_t embedding_size = embedding.size();
+    fwrite(&embedding_size, sizeof(embedding_size), 1, file);
+    fwrite(embedding.data(), sizeof(float), embedding.size(), file);
+    
+    fclose(file);
+    return true;
+}
+
+// Load a vector of floats from GGUF file with ICL data support
+static bool load_embedding_from_gguf(const std::string& filename, std::vector<float>& embedding,
+                                      std::string* ref_text = nullptr, 
+                                      std::vector<int32_t>* ref_codes = nullptr,
+                                      int32_t* n_ref_frames = nullptr) {
+    FILE* file = fopen(filename.c_str(), "rb");
+    if (!file) return false;
+
+    // Read magic number
+    uint32_t magic;
+    if (fread(&magic, sizeof(magic), 1, file) != 1) {
+        fclose(file);
+        return false;
+    }
+    if (magic != 0x47475546) {  // "GGUF"
+        fclose(file);
+        return false;
+    }
+
+    // Read version
+    uint32_t version;
+    if (fread(&version, sizeof(version), 1, file) != 1) {
+        fclose(file);
+        return false;
+    }
+
+    // Read data type flag
+    uint8_t data_type = 0;
+    if (fread(&data_type, sizeof(data_type), 1, file) != 1) {
+        fclose(file);
+        return false;
+    }
+
+    if (version == 1 && data_type == 0) {
+        // Legacy version 1 format - simple embedding only
+        fseek(file, 0, SEEK_END);
+        size_t file_size = ftell(file);
+        fseek(file, 12, SEEK_SET);  // Skip header (4+4+4 bytes)
+        
+        size_t embedding_size = (file_size - 12) / sizeof(float);
+        embedding.resize(embedding_size);
+        fread(embedding.data(), sizeof(float), embedding_size, file);
+    } else if (version >= 2 && data_type == 1) {
+        // Version 2+ with ICL data
+        // Read ref_text if requested
+        if (ref_text != nullptr) {
+            uint32_t ref_text_len;
+            if (fread(&ref_text_len, sizeof(ref_text_len), 1, file) != 1) {
+                fclose(file);
+                return false;
+            }
+            ref_text->resize(ref_text_len);
+            fread(&(*ref_text)[0], 1, ref_text_len, file);
+        }
+
+        // Read ref_codes if requested
+        if (ref_codes != nullptr) {
+            uint32_t ref_codes_count;
+            if (fread(&ref_codes_count, sizeof(ref_codes_count), 1, file) != 1) {
+                fclose(file);
+                return false;
+            }
+            ref_codes->resize(ref_codes_count);
+            if (ref_codes_count > 0) {
+                fread(ref_codes->data(), sizeof(int32_t), ref_codes_count, file);
+            }
+        }
+
+        // Read n_ref_frames if requested
+        if (n_ref_frames != nullptr) {
+            if (fread(n_ref_frames, sizeof(*n_ref_frames), 1, file) != 1) {
+                fclose(file);
+                return false;
+            }
+        }
+
+        // Read embedding size and data
+        uint32_t embedding_size;
+        if (fread(&embedding_size, sizeof(embedding_size), 1, file) != 1) {
+            fclose(file);
+            return false;
+        }
+        embedding.resize(embedding_size);
+        fread(embedding.data(), sizeof(float), embedding_size, file);
+    } else if (version >= 2 && data_type == 0) {
+        // Version 2+ with simple embedding only
+        uint32_t embedding_size;
+        if (fread(&embedding_size, sizeof(embedding_size), 1, file) != 1) {
+            fclose(file);
+            return false;
+        }
+        embedding.resize(embedding_size);
+        fread(embedding.data(), sizeof(float), embedding_size, file);
+    }
+
+    fclose(file);
+    return true;
+}
