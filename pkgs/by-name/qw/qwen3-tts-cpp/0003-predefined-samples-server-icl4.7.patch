+// Voice settings structure for custom voice configuration
+struct voice_settings {
+    bool auto_txt = true;         // finds the `.txt` or `.md` files relative to audio
+    bool auto_cache = true;       // loads a cache gguf if exists relative to the audio (remember caches need to match the model type)
+    bool require_cache = false;   // must have cached gguf
+    bool enable_icl = true;       // enable ICL support (use ref_text, ref_codes, and n_ref_frames)
+    std::string default_language = ""; // empty will turn into english
+};
+
+// Parse INI file format and populate voice definitions
+static bool parse_ini_file(const std::string& ini_path, std::map<std::string, voice_settings>& voices_config) {
+    std::ifstream file(ini_path);
+    if (!file.is_open()) {
+        fprintf(stderr, "Error: Failed to open INI file %s\n", ini_path.c_str());
+        return false;
+    }
+    
+    std::string line;
+    std::string current_section;
+    
+    while (std::getline(file, line)) {
+        // Skip empty lines and comments
+        if (line.empty() || line[0] == '#' || line[0] == ';') {
+            continue;
+        }
+        
+        // Check for section header [section_name]
+        if (line[0] == '[') {
+            size_t end = line.find(']');
+            if (end != std::string::npos) {
+                current_section = line.substr(1, end - 1);
+                // Initialize with default settings
+                voices_config[current_section] = voice_settings{};
+            }
+            continue;
+        }
+        
+        // Parse key=value pairs
+        size_t equals_pos = line.find('=');
+        if (equals_pos != std::string::npos) {
+            std::string key = line.substr(0, equals_pos);
+            std::string value = line.substr(equals_pos + 1);
+            
+            // Trim whitespace from both sides
+            key.erase(0, key.find_first_not_of(" \t"));
+            key.erase(key.find_last_not_of(" \t") + 1);
+            value.erase(0, value.find_first_not_of(" \t"));
+            value.erase(value.find_last_not_of(" \t\r\n") + 1);
+            
+            // Handle boolean values
+            if (key == "auto_txt" && current_section != "") {
+                voices_config[current_section].auto_txt = (value == "true" || value == "1");
+            } else if (key == "auto_cache" && current_section != "") {
+                voices_config[current_section].auto_cache = (value == "true" || value == "1");
+            } else if (key == "require_cache" && current_section != "") {
+                voices_config[current_section].require_cache = (value == "true" || value == "1");
+            } else if (key == "enable_icl" && current_section != "") {
+                voices_config[current_section].enable_icl = (value == "true" || value == "1");
+            }
+        }
+    }
+    
+    file.close();
+    return true;
+}
