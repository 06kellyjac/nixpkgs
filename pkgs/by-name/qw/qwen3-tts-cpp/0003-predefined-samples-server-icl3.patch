+// Save a vector of floats as GGUF file
+static bool save_embedding_as_gguf(const std::string& filename, const std::vector<float>& embedding) {
+    // Create a simple GGUF header for storing embeddings
+    FILE* file = fopen(filename.c_str(), "wb");
+    if (!file) return false;
+    
+    // Simple GGUF-like structure:
+    // Magic number (4 bytes)
+    uint32_t magic = 0x47475546;  // "GGUF"
+    fwrite(&magic, sizeof(magic), 1, file);
+    
+    // Version (4 bytes)
+    uint32_t version = 1;
+    fwrite(&version, sizeof(version), 1, file);
+    
+    // Tensor count (4 bytes) - we'll store just one tensor
+    uint32_t tensor_count = 1;
+    fwrite(&tensor_count, sizeof(tensor_count), 1, file);
+    
+    // For now, write the embedding data directly
+    fwrite(embedding.data(), sizeof(float), embedding.size(), file);
+    
+    fclose(file);
+    return true;
+}
+
+// Load a vector of floats from GGUF file
+static bool load_embedding_from_gguf(const std::string& filename, std::vector<float>& embedding) {
+    FILE* file = fopen(filename.c_str(), "rb");
+    if (!file) return false;
+    
+    // Read magic number
+    uint32_t magic;
+    if (fread(&magic, sizeof(magic), 1, file) != 1) {
+        fclose(file);
+        return false;
+    }
+    
+    if (magic != 0x47475546) {  // "GGUF"
+        fclose(file);
+        return false;
+    }
+    
+    // Read version
+    uint32_t version;
+    if (fread(&version, sizeof(version), 1, file) != 1) {
+        fclose(file);
+        return false;
+    }
+    
+    // Read tensor count
+    uint32_t tensor_count;
+    if (fread(&tensor_count, sizeof(tensor_count), 1, file) != 1) {
+        fclose(file);
+        return false;
+    }
+    
+    // Calculate the size of embedding data
+    fseek(file, 0, SEEK_END);
+    long file_size = ftell(file);
+    fseek(file, 12, SEEK_SET);  // Skip header (4+4+4 bytes)
+    
+    size_t data_size = (file_size - 12) / sizeof(float);
+    embedding.resize(data_size);
+    
+    if (fread(embedding.data(), sizeof(float), data_size, file) != data_size) {
+        fclose(file);
+        return false;
+    }
+    
+    fclose(file);
+    return true;
+}
