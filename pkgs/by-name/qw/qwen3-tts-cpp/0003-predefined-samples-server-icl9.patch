@@ -0,0 +1,229 @@
+#include "gguf_voice_bank_loader.h"
+#include "gguf.h"
+#include "ggml.h"
+
+#include <stdexcept>
+#include <cstring>
+#include <algorithm>
+
+namespace qwen3_tts {
+
+// ---------------------------------------------------------------------
+// Load entry
+// ---------------------------------------------------------------------
+
+void GGUFVoiceBank::load_v1(gguf_context* ctx) {
+    const uint32_t count =
+        gguf_get_val_u32(ctx, gguf_find_key(ctx, "voice.count"));
+
+    voices_.resize(count);
+    index_by_name_.reserve(count);
+
+    for (uint32_t i = 0; i < count; ++i) {
+        auto& v = voices_[i];
+
+        // ---------------- metadata ----------------
+
+        std::string prefix = "voice." + std::to_string(i) + ".";
+
+        v.name =
+            gguf_get_val_str(ctx, gguf_find_key(ctx, (prefix + "name").c_str()));
+
+        v.n_ref_frames =
+            gguf_get_val_u32(ctx, gguf_find_key(ctx, (prefix + "n_ref_frames").c_str()));
+
+        v.n_ref_codebooks =
+            gguf_get_val_u32(ctx, gguf_find_key(ctx, (prefix + "n_ref_codebooks").c_str()));
+
+        v.ref_audio_sha256 =
+            gguf_get_val_str(ctx, gguf_find_key(ctx, (prefix + "ref_audio_sha256").c_str()));
+
+        v.ref_text =
+            gguf_get_val_str(ctx, gguf_find_key(ctx, (prefix + "ref_text").c_str()));
+
+        index_by_name_[v.name] = i;
+    }
+}
+
+// ---------------------------------------------------------------------
+// Public load
+// ---------------------------------------------------------------------
+
+bool GGUFVoiceBank::loadFromFile(const std::string& path) {
+    fprintf(stderr, "[VOICE] GGUFVoiceBank::loadFromFile called with path: %s\n", path.c_str());
+    
+    // Open the file with proper parameters to get full data access
+    gguf_init_params params{};
+    params.no_alloc = true;
+
+    ctx_ = gguf_init_from_file(path.c_str(), params);
+
+    if (!ctx_) {
+        fprintf(stderr, "[VOICE] Failed to open GGUF file\n");
+        return false;
+    }
+
+    uint32_t version =
+        gguf_get_val_u32(ctx_, gguf_find_key(ctx_, "voice.schema_version"));
+
+    if (version != 1) {
+        throw std::runtime_error("Unsupported voice bank schema version");
+    }
+
+    fprintf(stderr, "[VOICE] Calling load_v1\n");
+    load_v1(ctx_);
+
+    fprintf(stderr, "[VOICE] Calling load_embedding_tensors\n");
+    // Load embedding data for each voice
+    load_embedding_tensors(path);
+
+    return true;
+}
+
+// ---------------------------------------------------------------------
+// Load embedding tensors from the GGUF file
+// ---------------------------------------------------------------------
+
+void GGUFVoiceBank::load_embedding_tensors(const std::string& path) {
+    if (!ctx_) return;
+    
+    // Open the file to read tensor data
+    FILE* f = fopen(path.c_str(), "rb");
+    if (!f) {
+        fprintf(stderr, "Error: Cannot open GGUF file for embedding loading\n");
+        return;
+    }
+
+    // Debug: List all tensors in the file to help identify embedding structure
+    int64_t n_tensors = gguf_get_n_tensors(ctx_);
+    fprintf(stderr, "Debug: Found %ld tensors in GGUF file\n", (long)n_tensors);
+    
+    // Print first few tensor names for debugging
+    for (int64_t i = 0; i < std::min(n_tensors, int64_t(10)); ++i) {
+        const char* name = gguf_get_tensor_name(ctx_, i);
+        if (name) {
+            fprintf(stderr, "Debug: Tensor %ld: '%s'\n", (long)i, name);
+        }
+    }
+
+    // Read embedding tensors for each voice
+    for (size_t i = 0; i < voices_.size(); ++i) {
+        auto& voice = voices_[i];
+        bool found = false;
+        
+        fprintf(stderr, "Debug: Looking for embedding data for voice '%s' at index %zu\n", voice.name.c_str(), i);
+        
+        // Try to find exact tensor name matching the expected pattern
+        std::string expected_name = "voice." + std::to_string(i) + ".embedding";
+        
+        // First try finding by exact name match
+        for (int64_t j = 0; j < n_tensors; ++j) {
+            const char* current_tensor_name = gguf_get_tensor_name(ctx_, j);
+            if (current_tensor_name && 
+                std::string(current_tensor_name) == expected_name) {
+                
+                fprintf(stderr, "Debug: Found exact tensor name '%s'\n", expected_name.c_str());
+                
+                int64_t tensor_idx = j;
+                size_t offset = gguf_get_tensor_offset(ctx_, tensor_idx);
+                size_t size = gguf_get_tensor_size(ctx_, tensor_idx);
+                
+                // Allocate memory for embedding data
+                voice.embedding_dim = size / sizeof(float);
+                if (voice.embedding_dim > 0) {
+                    voice.embedding = new float[voice.embedding_dim];
+                    
+                    // Seek to the tensor data position and read
+                    fseek(f, offset, SEEK_SET);
+                    size_t bytes_read = fread(voice.embedding, 1, size, f);
+                    if (bytes_read != size) {
+                        fprintf(stderr, "Warning: Only read %zu bytes of %zu expected for voice embedding %s\n", 
+                               bytes_read, size, voice.name.c_str());
+                        // Clean up on error
+                        delete[] voice.embedding;
+                        voice.embedding = nullptr;
+                        voice.embedding_dim = 0;
+                    } else {
+                        fprintf(stderr, "Debug: Successfully loaded embedding for voice '%s' (%u elements)\n", 
+                               voice.name.c_str(), voice.embedding_dim);
+                        found = true;
+                    }
+                    break;
+                }
+            }
+        }
+        
+        if (!found && !voice.name.empty()) {
+            // Try to find any tensor that contains the voice name and "embedding"
+            fprintf(stderr, "Debug: Trying flexible tensor matching for voice '%s'\n", voice.name.c_str());
+            for (int64_t j = 0; j < n_tensors; ++j) {
+                const char* current_tensor_name = gguf_get_tensor_name(ctx_, j);
+                if (current_tensor_name) {
+                    std::string name_str(current_tensor_name);
+                    
+                    // Check if this tensor contains the voice name and "embedding"
+                    if (name_str.find(voice.name) != std::string::npos && 
+                        name_str.find("embedding") != std::string::npos) {
+                        
+                        fprintf(stderr, "Debug: Found matching tensor by flexible method: '%s'\n", current_tensor_name);
+                        
+                        int64_t tensor_idx = j;
+                        size_t offset = gguf_get_tensor_offset(ctx_, tensor_idx);
+                        size_t size = gguf_get_tensor_size(ctx_, tensor_idx);
+                        
+                        // Allocate memory for embedding data
+                        voice.embedding_dim = size / sizeof(float);
+                        if (voice.embedding_dim > 0) {
+                            voice.embedding = new float[voice.embedding_dim];
+                            
+                            // Seek to the tensor data position and read
+                            fseek(f, offset, SEEK_SET);
+                            size_t bytes_read = fread(voice.embedding, 1, size, f);
+                            if (bytes_read != size) {
+                                fprintf(stderr, "Warning: Only read %zu bytes of %zu expected for voice embedding %s\n", 
+                                       bytes_read, size, voice.name.c_str());
+                                // Clean up on error
+                                delete[] voice.embedding;
+                                voice.embedding = nullptr;
+                                voice.embedding_dim = 0;
+                            } else {
+                                fprintf(stderr, "Debug: Successfully loaded embedding (flexible) for voice '%s' (%u elements)\n", 
+                                       voice.name.c_str(), voice.embedding_dim);
+                                found = true;
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        
+        if (!found) {
+            fprintf(stderr, "Warning: No embedding tensor found for voice '%s'\n", voice.name.c_str());
+        }
+    }
+    
+    fclose(f);
+}
+
+// ---------------------------------------------------------------------
+// Lookup
+// ---------------------------------------------------------------------
+
+const GGUFVoiceEntry*
+GGUFVoiceBank::getVoice(const std::string& name) const {
+
+    auto it = index_by_name_.find(name);
+    if (it == index_by_name_.end()) return nullptr;
+
+    return &voices_[it->second];
+}
+
+const GGUFVoiceEntry*
+GGUFVoiceBank::getVoice(size_t index) const {
+
+    if (index >= voices_.size()) return nullptr;
+    return &voices_[index];
+}
+
+} // namespace qwen3_tts
