new file mode 100644
index 0000000..a583fc8
--- /dev/null
+++ b/src/gguf_voice_bank_loader.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <string>
+#include <vector>
+#include <unordered_map>
+#include <memory>
+#include <cstdint>
+
+struct gguf_context;
+struct ggml_tensor;
+
+namespace qwen3_tts {
+
+struct GGUFVoiceEntry {
+    std::string name;
+
+    uint32_t n_ref_frames = 0;
+    uint32_t n_ref_codebooks = 0;
+    uint32_t embedding_dim = 0;
+
+    std::string ref_text;
+    std::string ref_audio_sha256;
+
+    float* embedding = nullptr;  // Changed to non-const pointer
+    const uint16_t* ref_codes = nullptr;
+
+    size_t ref_code_count = 0;
+};
+
+class GGUFVoiceBank {
+public:
+    GGUFVoiceBank() = default;
+    ~GGUFVoiceBank() {
+        // Clean up allocated embedding memory
+        for (auto& voice : voices_) {
+            delete[] voice.embedding;
+        }
+    }
+
+    bool loadFromFile(const std::string& path);
+
+    const GGUFVoiceEntry* getVoice(const std::string& name) const;
+    const GGUFVoiceEntry* getVoice(size_t index) const;
+
+    size_t size() const { return voices_.size(); }
+
+private:
+    std::vector<GGUFVoiceEntry> voices_;
+    std::unordered_map<std::string, size_t> index_by_name_;
+
+    gguf_context* ctx_ = nullptr; // must outlive tensor pointers
+
+private:
+    void load_v1(gguf_context* ctx);
+    void load_embedding_tensors(const std::string& path);
+};
+
+} // namespace qwen3_tts
diff --git a/src/gguf_voice_bank_writer.cpp b/src/gguf_voice_bank_writer.cpp
new file mode 100644
index 0000000..d44dd6e
--- /dev/null
+++ b/src/gguf_voice_bank_writer.cpp
@@ -0,0 +1,157 @@
+#include "gguf_voice_bank_writer.h"
+
+#include "gguf.h"
+#include "ggml.h"
+
+#include <stdexcept>
+#include <cstring>
+
+namespace qwen3_tts {
+
+// ---------------------------------------------------------------------
+// Constructor
+// ---------------------------------------------------------------------
+
+GGUFVoiceBankWriter::GGUFVoiceBankWriter() = default;
+
+// ---------------------------------------------------------------------
+// Add voice
+// ---------------------------------------------------------------------
+
+void GGUFVoiceBankWriter::addVoice(const GGUFVoiceBankEntryBuilder& voice) {
+    voices_.push_back(voice);
+}
+
+// ---------------------------------------------------------------------
+// Validation
+// ---------------------------------------------------------------------
+
+void GGUFVoiceBankWriter::validate() const {
+
+    if (voices_.empty()) {
+        throw std::runtime_error("GGUFVoiceBankWriter: no voices added");
+    }
+
+    for (const auto& v : voices_) {
+
+        if (v.name.empty()) {
+            throw std::runtime_error("Voice has empty name");
+        }
+
+        if (v.embedding.empty()) {
+            throw std::runtime_error("Voice missing embedding");
+        }
+
+        if (!v.ref_codes.empty()) {
+
+            size_t expected =
+                static_cast<size_t>(v.n_ref_frames) *
+                static_cast<size_t>(v.n_ref_codebooks);
+
+            if (expected != v.ref_codes.size()) {
+                throw std::runtime_error(
+                    "ref_codes size mismatch for voice: " + v.name);
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------
+// Write GGUF
+// ---------------------------------------------------------------------
+
+bool GGUFVoiceBankWriter::writeToFile(const std::string& path) {
+
+    validate();
+
+    gguf_context* ctx = gguf_init_empty();
+    ggml_context* gctx = nullptr;
+
+    // -------------------------------------------------------------
+    // Global metadata
+    // -------------------------------------------------------------
+
+    gguf_set_val_u32(ctx, "voice.schema_version", schema_version_);
+    gguf_set_val_u32(ctx, "voice.count", (uint32_t)voices_.size());
+
+    // -------------------------------------------------------------
+    // Tensor context
+    // -------------------------------------------------------------
+
+    ggml_init_params params{};
+    params.mem_size = 64ull * 1024ull * 1024ull;
+    params.no_alloc = false;
+
+    gctx = ggml_init(params);
+
+    // -------------------------------------------------------------
+    // Write voices
+    // -------------------------------------------------------------
+
+    for (size_t i = 0; i < voices_.size(); ++i) {
+
+        const auto& v = voices_[i];
+
+        std::string p = "voice." + std::to_string(i) + ".";
+
+        // ---------------- metadata ----------------
+
+        gguf_set_val_str(ctx, (p + "name").c_str(), v.name.c_str());
+
+        gguf_set_val_u32(ctx, (p + "n_ref_frames").c_str(), v.n_ref_frames);
+
+        gguf_set_val_u32(ctx, (p + "n_ref_codebooks").c_str(), v.n_ref_codebooks);
+
+        gguf_set_val_str(ctx, (p + "ref_text").c_str(), v.ref_text.c_str());
+
+        gguf_set_val_str(ctx, (p + "ref_audio_sha256").c_str(), v.ref_audio_sha256.c_str());
+
+        // ---------------- embedding tensor ----------------
+
+        ggml_tensor* emb =
+            ggml_new_tensor_1d(
+                gctx,
+                GGML_TYPE_F32,
+                v.embedding.size());
+
+        std::memcpy(
+            emb->data,
+            v.embedding.data(),
+            v.embedding.size() * sizeof(float));
+
+        ggml_set_name(emb, (p + "embedding").c_str());
+        gguf_add_tensor(ctx, emb);
+
+        // ---------------- ref codes (uint16 compressed) ----------------
+
+        if (!v.ref_codes.empty()) {
+
+            ggml_tensor* rc =
+                ggml_new_tensor_1d(
+                    gctx,
+                    GGML_TYPE_I16,
+                    v.ref_codes.size());
+
+            std::memcpy(
+                rc->data,
+                v.ref_codes.data(),
+                v.ref_codes.size() * sizeof(uint16_t));
+
+            ggml_set_name(rc, (p + "ref_codes").c_str());
+            gguf_add_tensor(ctx, rc);
+        }
+    }
+
+    // -------------------------------------------------------------
+    // Write file
+    // -------------------------------------------------------------
+
+    bool ok = gguf_write_to_file(ctx, path.c_str(), false);
+
+    gguf_free(ctx);
+    ggml_free(gctx);
+
+    return ok;
+}
+
+} // namespace qwen3_tts
